{
  "name": "cart-delivery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:offline": "tsc --noEmit && VITE_ARTIFACT=1 VITE_OFFLINE=1 vite build --base=./ --outDir dist-offline",
    "build:preview-link": "tsc --noEmit && VITE_ARTIFACT=1 vite build --base=./ --outDir dist-artifact"
  },
  "dependencies": {
    "lenis": "1.1.20",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
