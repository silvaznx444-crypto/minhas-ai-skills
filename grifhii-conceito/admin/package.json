{
  "name": "grifhii-admin",
  "private": true,
  "type": "module",
  "description": "GRIFHII CONCEITO — painel administrativo (Cloudflare Worker + D1 + Shopify Admin API).",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply GRIFHII_ADMIN_DB --local",
    "migrate:remote": "wrangler d1 migrations apply GRIFHII_ADMIN_DB --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  }
}
